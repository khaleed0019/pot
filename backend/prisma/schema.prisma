// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  /// Supabase Auth user id (the JWT `sub` claim). Null until first sign-in, so
  /// an account can be seeded by email and linked when that user first logs in.
  authUid       String?   @unique
  name          String?
  role          Role      @default(USER)
  /// Blocks sign-in/API access without deleting the account or its listings —
  /// the reversible alternative to a hard delete.
  suspended     Boolean   @default(false)
  profileImage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  properties    Property[] @relation("UserProperties")
  favorites     Favorite[]
  reviews       Review[]
  agentProfile  Agent?
  reviewedListings Property[] @relation("ReviewedBy")
  propertyHistory  PropertyHistory[]
  clientDeals   Deal[]    @relation("ClientDeals")
}

enum Role {
  USER
  AGENT
  ADMIN
}

model Agent {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  bio          String?
  phone        String?
  specialty    String?
  rating       Float     @default(0)
  reviews      Review[]
  listings     Property[] @relation("AgentProperties")
  createdAt    DateTime  @default(now())
  deals        Deal[]
}

model Property {
  id              String    @id @default(uuid())
  title           String    @default("")
  description     String    @default("")
  address         String    @default("")
  city            String    @default("")
  state           String    @default("")
  country         String    @default("")
  price           Float     @default(0)
  currency        String    @default("USD")
  propertyType    String    @default("")
  type            ListingType @default(SALE)
  status          PropertyStatus @default(DRAFT)
  bedrooms        Int       @default(0)
  bathrooms       Int       @default(0)
  toilets         Int       @default(0)
  squareFootage   Float     @default(0)
  squareMeters    Float?
  landSize        Float?
  furnishing      String?
  parkingSpaces   Int?
  floorNumber     Int?
  totalFloors     Int?
  yearBuilt       Int?
  amenities       String    @default("[]")
  images          String    @default("[]")
  coverImage      String?
  videoUrl        String?
  tour360Url      String?
  lat             Float?
  lng             Float?
  landmark        String?
  neighborhood    String?
  estateName      String?
  serviceCharge   Float?
  agencyFee       Float?
  cautionFee      Float?
  inspectionFee   Float?
  contactPhone    String?
  contactWhatsapp String?
  contactEmail    String?
  isFeatured      Boolean   @default(false)
  externalUrl     String?
  draftStep       Int       @default(1)
  lastSavedAt     DateTime  @default(now())
  listingViews    Int       @default(0)
  totalLeads      Int       @default(0)
  rejectionReason String?
  adminNote       String?

  ownerId         String
  owner           User      @relation("UserProperties", fields: [ownerId], references: [id])

  agentId         String?
  agent           Agent?    @relation("AgentProperties", fields: [agentId], references: [id])

  reviewedById    String?
  reviewedBy      User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  approvedAt      DateTime?

  favorites       Favorite[]
  investmentData  InvestmentDetail?
  history         PropertyHistory[]
  leads           PropertyLead[]
  deals           Deal[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum ListingType {
  SALE
  RENT
  SHORTLET
  INVESTMENT
}

enum PropertyStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
  /// Taken offline by an admin without deleting it — invisible to GET
  /// /properties (which only returns PUBLISHED) but restorable.
  SUSPENDED
}

enum PropertyHistoryAction {
  CREATED
  DRAFT_SAVED
  SUBMITTED
  APPROVED
  REJECTED
  REQUESTED_CHANGES
  PUBLISHED
  LEAD_RECORDED
  VIEW_RECORDED
}

enum LeadType {
  WHATSAPP
  CALL
  INSPECTION
  SAVE
  SHARE
}

model PropertyHistory {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      PropertyHistoryAction
  fromStatus  PropertyStatus?
  toStatus    PropertyStatus?
  note        String?
  createdAt   DateTime @default(now())
}

model PropertyLead {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId      String?
  leadType    LeadType
  createdAt   DateTime @default(now())
}

model InvestmentDetail {
  id            String    @id @default(uuid())
  propertyId    String    @unique
  property      Property  @relation(fields: [propertyId], references: [id])
  roi           Float?
  rentalYield   Float?
  marketTrend   String?
  description   String?
}

model Review {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Favorite {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([userId, propertyId])
}

enum PaymentPlan {
  FULL
  INSTALLMENT
}

enum DealStatus {
  PROPOSED
  COUNTERED
  AGREED
  CANCELLED
}

enum DealParty {
  AGENT
  CLIENT
}

/// A price + payment-plan agreement between an agent and a client on a
/// property. No money moves here — this is a mutual-consent record: whoever
/// last changed the terms is "proposing", and the deal only becomes AGREED
/// once both sides have confirmed the exact same terms.
model Deal {
  id              String        @id @default(uuid())

  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  agentId         String
  agent           Agent         @relation(fields: [agentId], references: [id])

  clientId        String
  client          User          @relation("ClientDeals", fields: [clientId], references: [id])

  amount          Float
  currency        String        @default("USD")
  paymentPlan     PaymentPlan   @default(FULL)
  installments    Installment[]

  status          DealStatus    @default(PROPOSED)
  lastProposedBy  DealParty
  agentAgreed     Boolean       @default(false)
  clientAgreed    Boolean       @default(false)
  agreedAt        DateTime?

  note            String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([propertyId, clientId])
}

model Installment {
  id        String    @id @default(uuid())
  dealId    String
  deal      Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  seq       Int
  amount    Float
  dueDate   DateTime
  paid      Boolean   @default(false)
  paidAt    DateTime?
}
