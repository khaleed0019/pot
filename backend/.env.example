# Supabase — Project Settings → Database → Connection string
# Transaction pooler (port 6543) — use at runtime (Render, local API)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session / direct pooler (port 5432) — Prisma migrations (`migrate deploy`, `migrate dev`)
# Encode special characters in password (@ → %40, etc.)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-west-1.pooler.supabase.com:5432/postgres"

# Supabase Auth — used to fetch the JWKS that verifies access tokens
SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# CORS — local or Vercel URL (no trailing slash)
FRONTEND_URL=http://localhost:3000

PORT=5001
NODE_ENV=development

# Optional — image uploads
CLOUDINARY_URL=
