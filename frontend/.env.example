# Vercel: add these in Project → Settings → Environment Variables

# Firebase Web app config (Firebase Console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Render backend URL (must include /api path)
# Local: http://localhost:5001/api
# Production: https://your-service.onrender.com/api
NEXT_PUBLIC_API_URL=

# Optional — Mapbox map picker on listing wizard
NEXT_PUBLIC_MAPBOX_TOKEN=
